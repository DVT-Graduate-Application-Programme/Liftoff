# Development secrets — copy to secrets.dev.tfvars and fill in. The copy is gitignored.
#
#   terraform workspace select default
#   terraform apply -var-file=secrets.dev.tfvars
#
# Only credentials and per-environment identifiers belong here. Everything that describes
# the *shape* of the environment (tiers, replica counts, retention) lives in
# environments.tf, which is committed and reviewed.
#
# Migrating from the old layout: the existing terraform.tfvars is this file. Rename it to
# secrets.dev.tfvars so it stops auto-loading — an auto-loaded terraform.tfvars is read in
# every workspace, including prod, which would feed dev credentials into a prod apply for
# any variable the prod file happens not to set.

environment = "dev"

subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# ── Database ──────────────────────────────────────────────────────────────────
db_name     = "GradRecruitment"
db_username = "appuser"
db_password = "replace-me"

# ── Service-to-service auth ───────────────────────────────────────────────────
internal_api_key     = "replace-me"
worker_admin_api_key = "replace-me"

# ── Hiring agent ──────────────────────────────────────────────────────────────
gemini_api_key = "replace-me"
github_token   = ""

# ── Frontend auth (Auth.js + Microsoft Entra ID) ──────────────────────────────
auth_secret                    = "replace-me"
auth_microsoft_entra_id_id     = "replace-me"
auth_microsoft_entra_id_secret = "replace-me"
auth_microsoft_entra_id_issuer = "https://login.microsoftonline.com/<tenant-id>/v2.0"

# ── Monitoring ────────────────────────────────────────────────────────────────
alert_email = "team@example.com"

# ── Team access ───────────────────────────────────────────────────────────────
# Entra security group whose members get Reader. Must differ from the prod group.
reader_group_object_id = "00000000-0000-0000-0000-000000000000"

# ── Images ────────────────────────────────────────────────────────────────────
# Set after the first apply, as "<acr_login_server>/<component>" — e.g.
# "$(terraform output -raw acr_login_server)/backend". Left empty they default to
# :latest in the environment's own registry.
backend_image      = ""
frontend_image     = ""
worker_image       = ""
hiring_agent_image = ""
migrations_image   = ""

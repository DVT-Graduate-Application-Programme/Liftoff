# Production secrets — copy to secrets.prod.tfvars and fill in. The copy is gitignored.
#
#   terraform workspace new prod      # first time only
#   terraform workspace select prod
#   terraform plan  -var-file=secrets.prod.tfvars
#   terraform apply -var-file=secrets.prod.tfvars
#
# NOTHING HERE MAY BE COPIED FROM DEV. Sharing a database password, an internal API key or
# an Entra client secret between environments means a dev-side leak is a production
# incident — and dev's values are, today, in a committed .env.development.
#
# This environment does not exist on Azure yet. See README.md in this directory for the
# bootstrap checklist that goes with the first apply.

environment = "prod"

# Can be a different subscription from dev. If it is the same one, note that the Reader
# assignment in iam.tf is subscription-scoped, so prod needs its own group (below).
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# ── Database ──────────────────────────────────────────────────────────────────
db_name     = "GradRecruitment"
db_username = "appuser"
db_password = "" # generate, e.g. `openssl rand -base64 32`, and store in a password manager

# ── Service-to-service auth ───────────────────────────────────────────────────
internal_api_key     = "" # openssl rand -hex 32
worker_admin_api_key = "" # openssl rand -hex 32 — empty disables the admin endpoints

# ── Hiring agent ──────────────────────────────────────────────────────────────
# A separate Gemini key from dev, so prod quota and dev experimentation do not share a
# rate limit and either can be revoked alone.
gemini_api_key = ""
github_token   = ""

# ── Frontend auth (Auth.js + Microsoft Entra ID) ──────────────────────────────
# Register a second Entra application for production. Its redirect URI must be the prod
# frontend's AUTH_URL + /api/auth/callback/microsoft-entra-id — the value compute.tf pins,
# which is only known after the first apply. Expect: apply, read the frontend URL from the
# outputs, add the redirect URI in Entra, then sign in.
auth_secret                    = "" # openssl rand -base64 32
auth_microsoft_entra_id_id     = ""
auth_microsoft_entra_id_secret = ""
auth_microsoft_entra_id_issuer = "https://login.microsoftonline.com/<tenant-id>/v2.0"

# ── Monitoring ────────────────────────────────────────────────────────────────
# Prod alerts should reach a monitored inbox, not one person's mailbox.
alert_email = ""

# ── Team access ───────────────────────────────────────────────────────────────
# Create a distinct group (e.g. liftoff-prod-readers) before setting this; leave it empty
# and the role assignment is skipped, which is fine for the first apply.
reader_group_object_id = ""

# ── Images ────────────────────────────────────────────────────────────────────
# Left empty these default to :latest in the prod registry. The deploy workflow pins each
# app to a prod-<sha> tag on every run, so these only matter for the very first apply.
backend_image      = ""
frontend_image     = ""
worker_image       = ""
hiring_agent_image = ""
migrations_image   = ""
